include README.md README.zh-CN.md CONTRIBUTING.md AGENTS.md
recursive-include src/edc *.py *.yaml *.md
recursive-include configs *.yaml *.json *.urdf
recursive-include examples *.py *.toml
recursive-include tests *.yaml
recursive-include tests *.py
recursive-include .github *.yml
include scripts/check_release_contents.py
global-exclude *.pyc *.pyo
prune build
prune dist
prune examples/plugins/algorithm/build
prune examples/plugins/reader/build
global-exclude *.egg-info

recursive-include docs *.md *.svg *.json
include requirements-docs.txt docs/conf.py docs/search-dictionary.txt
recursive-include docs/_ext *.py
recursive-include docs/_templates *.html
recursive-include docs/_static *.css *.js *.svg
recursive-include docs/_tools *.py
recursive-include docs/presentations *.pptx
prune docs/_build
prune examples/plugins/quality_base/build
# The local value plugin is not part of the framework distribution.
prune plugins/value_assessment

# Internal work records and audit material are not distribution content.
global-exclude STATUS.md *_INTEGRATION_PLAN_*.md *_MIGRATION_PLAN_*.md *_VALIDATION_*.md
prune internal
prune audits
prune docs/internal
prune docs/audits
prune docs/evidence
